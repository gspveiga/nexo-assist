# An OpenAI key is required for LLM calls; without one, the app uses local routing.
OPENAI_API_KEY=
# Selected model: Mastra uses OpenAI when a key is configured; without a key the
# UI explicitly reports local routing mode.
NEXO_AGENT_MODE=mastra
NEXO_LLM_MODEL=openai/gpt-6.1-sol

# Change this for any deployment. A long random value is recommended.
SESSION_SECRET=change-me-to-a-long-random-secret
DB_PATH=./data/nexo-assist.sqlite
APP_TIMEZONE=America/Bahia
