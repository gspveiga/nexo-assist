# Install Ollama, start it, and download the configured model (see README).
NEXO_AGENT_MODE=mastra
NEXO_LLM_MODEL=ollama/qwen3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434/api

# Change this for any deployment. A long random value is recommended.
SESSION_SECRET=change-me-to-a-long-random-secret
DB_PATH=./data/nexo-assist.sqlite
APP_TIMEZONE=America/Bahia
