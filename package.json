{
  "name": "nexo-assist",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "next dev",
    "predev": "npm run db:seed",
    "build": "next build",
    "start": "next start",
    "prestart": "npm run db:seed",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:api": "node tests/http-smoke.mjs",
    "db:seed": "node --experimental-strip-types scripts/seed.ts",
    "db:reset": "node --experimental-strip-types scripts/reset-db.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@mastra/core": "latest",
    "next": "^16.4.3",
    "ollama-ai-provider-v2": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "^22.16.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "typescript": "^5.9.3"
  }
}
